                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            @endforeach
        </div>
        @endif

        {{-- Pagination --}}
        @if($articles->hasPages())
            <div style="margin-top:40px;">
                {{ $articles->appends(['category' => $activeCategory])->links() }}
