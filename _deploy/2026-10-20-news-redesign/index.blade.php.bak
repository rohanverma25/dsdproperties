        }

        /* ─── Base ──────────────────────────────────────── */
        .np { font-family:'Poppins',sans-serif; overflow-x:hidden; }
        .np-c { max-width:1100px; margin:0 auto; padding:0 20px; }

        /* ─── Scroll reveal ─────────────────────────────── */
        .np-rv {
            opacity:0; transform:translateY(22px);
            transition:opacity .55s ease, transform .55s ease;
            transition-delay:var(--rd,0s);
        }
        .np-rv.visible { opacity:1; transform:none; }

        /* ─── HERO ──────────────────────────────────────── */
        .np-hero {
            position:relative; overflow:hidden;
            background:linear-gradient(135deg,#0f1f5c 0%,#1a3a8f 50%,#2563eb 100%);
            padding:72px 0 0;
        }
        .np-hero__grid {
            position:absolute; inset:0;
            background-image:
                linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),
                linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);
            background-size:50px 50px;
        }
        @keyframes np-float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-14px)} }
        .np-orb { position:absolute; border-radius:50%; filter:blur(80px); pointer-events:none; }
        .np-orb--a { width:440px;height:440px;background:rgba(37,99,235,.3);top:-100px;right:-60px;animation:np-float 9s ease-in-out infinite; }
        .np-orb--b { width:300px;height:300px;background:rgba(255,92,0,.14);bottom:0;left:-40px;animation:np-float 11s ease-in-out infinite 3s; }

        .np-hero__inner { position:relative; z-index:2; text-align:center; padding-bottom:40px; }

        .np-hero__badge {
            display:inline-flex; align-items:center; gap:8px;
            background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.18);
            border-radius:99px; padding:6px 16px; margin-bottom:18px;
            font-size:11px; font-weight:500; color:rgba(255,255,255,.82);
            backdrop-filter:blur(8px);
        }
        .np-hero__badge-dot { width:7px;height:7px;border-radius:50%;background:#4ade80;display:inline-block; }

        .np-hero__h1 {
            font-size:clamp(1.9rem,4.5vw,3.1rem); font-weight:800; color:#fff;
            line-height:1.13; margin-bottom:14px; letter-spacing:-.3px;
        }
        .np-hero__h1 em { font-style:normal; color:#FF5C00; }
        .np-hero__sub {
            font-size:.92rem; color:rgba(255,255,255,.68);
            line-height:1.8; max-width:510px; margin:0 auto 32px;
        }
        .np-hero__stats {
            display:flex; justify-content:center; gap:40px; flex-wrap:wrap;
            padding-top:28px; border-top:1px solid rgba(255,255,255,.1);
        }
        .np-stat-val { font-size:1.55rem; font-weight:800; color:#fff; line-height:1; }
        .np-stat-val em { font-style:normal; color:#FF5C00; }
        .np-stat-lbl { font-size:.68rem; color:rgba(255,255,255,.5); margin-top:4px; text-transform:uppercase; letter-spacing:1px; }

        /* wave */
        .np-wave { line-height:0; position:relative; z-index:2; }
        .np-wave svg { display:block; width:100%; }

        /* ─── TICKER ─────────────────────────────────────── */
        @keyframes np-marquee { from{transform:translateX(100vw)} to{transform:translateX(-100%)} }
        .np-marquee { display:inline-block; white-space:nowrap; animation:np-marquee 38s linear infinite; }
        .np-marquee:hover { animation-play-state:paused; }

        /* ─── FILTER PILLS ───────────────────────────────── */
        .np-pills-wrap { overflow-x:auto; -ms-overflow-style:none; scrollbar-width:none; }
        .np-pills-wrap::-webkit-scrollbar { display:none; }
        .np-pill {
            white-space:nowrap; padding:7px 18px; border-radius:99px;
            font-size:.78rem; font-weight:600; text-decoration:none;
            border:1.5px solid #d1d5db; background:#fff; color:#4b5563;
            display:inline-block; transition:all .2s;
        }
        .np-pill:hover { border-color:#0f1f5c; color:#0f1f5c; text-decoration:none; }
        .np-pill--active { background:#0f1f5c !important; color:#fff !important; border-color:#0f1f5c !important; }

        /* ─── Category tag badges ─────────────────────────── */
        .tag-lda      { background:#f0fdf4; color:#16a34a; border-color:#bbf7d0; }
        .tag-it-city  { background:#eff6ff; color:#2563eb; border-color:#bfdbfe; }
        .tag-price    { background:#fff7ed; color:#ea580c; border-color:#fed7aa; }
        .tag-projects { background:#faf5ff; color:#7c3aed; border-color:#e9d5ff; }
        .tag-policy   { background:#fef2f2; color:#dc2626; border-color:#fecaca; }
        .tag-rera     { background:#f0fdfa; color:#0d9488; border-color:#99f6e4; }
        .tag-default  { background:#f9fafb; color:#6b7280; border-color:#e5e7eb; }
        .np-tag { font-size:.67rem; font-weight:700; padding:2px 10px; border-radius:99px; border-width:1px; border-style:solid; }

        .hot-badge { font-size:.62rem; font-weight:700; background:#fff5f5; color:#ef4444; border:1px solid #fecaca; padding:2px 8px; border-radius:99px; white-space:nowrap; }

        /* ─── Section heading ────────────────────────────── */
        .np-sec-label { font-size:10px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:#008080; margin-bottom:6px; }
        .np-sec-title { font-size:clamp(1.25rem,2.4vw,1.7rem); font-weight:800; color:#111827; line-height:1.2; }

        /* ─── FEATURED CARD ──────────────────────────────── */
        .np-featured {
            background:#fff; border:1px solid #e5e7eb; border-radius:20px;
            overflow:hidden; display:grid; grid-template-columns:260px 1fr;
            box-shadow:0 8px 40px rgba(0,0,0,.07);
            transition:transform .25s, box-shadow .25s;
        }
        .np-featured:hover { transform:translateY(-4px); box-shadow:0 20px 56px rgba(0,0,0,.11); }
        @media(max-width:680px){ .np-featured{ grid-template-columns:1fr; } }

        .np-featured__panel {
            padding:32px 26px; display:flex; flex-direction:column;
            justify-content:space-between; position:relative; overflow:hidden;
        }
        .np-featured__panel::before {
            content:''; position:absolute; inset:0;
            background:rgba(0,0,0,.28);
        }
        .np-featured__panel::after {
            content:''; position:absolute; inset:0;
            background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),
                             linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);
            background-size:32px 32px;
        }
        .np-featured__panel > * { position:relative; z-index:1; }
        .np-featured__panel-eyebrow { font-size:.62rem; font-weight:800; letter-spacing:.18em; text-transform:uppercase; color:rgba(255,255,255,.65); margin-bottom:6px; }
        .np-featured__panel-num { font-size:5rem; font-weight:900; color:rgba(255,255,255,.15); line-height:1; margin-bottom:auto; }
        .np-featured__panel-label { font-size:.82rem; font-weight:700; color:#fff; }
        .np-featured__panel-date  { font-size:.7rem; color:rgba(255,255,255,.5); margin-top:3px; }

        .np-featured__body { padding:32px 28px; display:flex; flex-direction:column; }
        @media(max-width:680px){ .np-featured__body{ padding:22px 20px; } }

        .np-featured__meta { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
        .np-featured__title {
            font-size:1.3rem; font-weight:800; color:#111827; line-height:1.35;
            margin-bottom:12px; text-decoration:none; display:block; transition:color .2s;
        }
        .np-featured__title:hover { color:#0f1f5c; text-decoration:none; }
        .np-featured__summary { font-size:.875rem; color:#6b7280; line-height:1.78; margin-bottom:22px; flex:1; }
        .np-featured__footer { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-top:auto; }

        /* ─── NEWS GRID CARDS ────────────────────────────── */
        .np-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
        @media(max-width:900px){ .np-grid{ grid-template-columns:1fr 1fr; } }
        @media(max-width:560px){ .np-grid{ grid-template-columns:1fr; } }

        .np-card {
            background:#fff; border:1px solid #e5e7eb; border-radius:16px;
            overflow:hidden; display:flex; flex-direction:column;
            transition:transform .25s, box-shadow .25s, border-color .25s;
        }
        .np-card:hover { transform:translateY(-5px); box-shadow:0 16px 44px rgba(0,0,0,.09); }

        .np-card__header {
            padding:18px 20px 16px; position:relative; overflow:hidden;
        }
        .np-card__header::after {
            content:''; position:absolute; inset:0;
            background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),
                             linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);
            background-size:24px 24px;
        }
        .np-card__header > * { position:relative; z-index:1; }
        .np-card__cat-label { font-size:.62rem; font-weight:800; letter-spacing:.15em; text-transform:uppercase; color:rgba(255,255,255,.75); }
        .np-card__header-title {
            font-size:.92rem; font-weight:700; color:#fff;
            line-height:1.35; margin-top:6px;
            display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
        }

        .np-card__body { padding:16px 20px 20px; display:flex; flex-direction:column; flex:1; }
        .np-card__meta { display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-bottom:10px; }
        .np-card__summary { font-size:.8rem; color:#6b7280; line-height:1.68; margin-bottom:16px; flex:1; }
        .np-card__footer { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:6px; margin-top:auto; }

        /* ─── Buttons ────────────────────────────────────── */
        .np-btn {
            display:inline-flex; align-items:center; gap:8px; font-weight:700;
            border-radius:10px; text-decoration:none; padding:11px 22px;
            font-size:.83rem; background:linear-gradient(135deg,#FF5C00,#ff8840);
            color:#fff; box-shadow:0 5px 18px rgba(255,92,0,.28); transition:all .22s; border:none; cursor:pointer;
        }
        .np-btn:hover { transform:translateY(-2px); box-shadow:0 8px 26px rgba(255,92,0,.4); color:#fff; text-decoration:none; }

        .np-read-link {
            display:inline-flex; align-items:center; gap:5px;
            font-size:.78rem; font-weight:600; color:#FF5C00;
            text-decoration:none; transition:gap .2s;
        }
        .np-read-link:hover { gap:9px; text-decoration:none; color:#FF5C00; }

        /* ─── Mobile buy/sell bar ────────────────────────── */
        .mob-cta-bar{display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;padding:10px 14px;background:#fff;border-top:1px solid #e5e7eb;box-shadow:0 -4px 18px rgba(0,0,0,.12);gap:10px}
        @media(max-width:1023px){.mob-cta-bar{display:flex}body{padding-bottom:72px}}
        .mob-cta-bar a{flex:1;display:flex;align-items:center;justify-content:center;gap:7px;padding:13px 10px;border-radius:10px;font-weight:700;font-size:.88rem;text-decoration:none;letter-spacing:.1px;transition:opacity .15s}
        .mob-cta-bar a:hover{opacity:.88;text-decoration:none}
        .mob-cta-buy{background:linear-gradient(135deg,#25D366,#128C7E);color:#fff !important}
        .mob-cta-sell{background:linear-gradient(135deg,#011f4b,#013870);color:#fff !important}
    </style>
@endsection

