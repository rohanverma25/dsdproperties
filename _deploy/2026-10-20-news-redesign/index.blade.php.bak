                            <span style="font-size:.68rem; color:#9ca3af;">{{ $article->created_at->diffForHumans() }}</span>
                        </div>
                        <p class="np-card__summary">{{ Str::limit($article->summary, 110) }}</p>
                        <div class="np-card__footer">
