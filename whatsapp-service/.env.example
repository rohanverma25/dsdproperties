# Copy to .env and fill in. The two tokens must match the ones in Laravel's .env.

# Port the gateway listens on (bound to 127.0.0.1 only).
WA_PORT=3001

# Laravel -> gateway. Must equal WHATSAPP_API_TOKEN in Laravel's .env.
WA_API_TOKEN=change-me-long-random-string

# Gateway -> Laravel. Must equal WHATSAPP_WEBHOOK_TOKEN in Laravel's .env.
WA_WEBHOOK_TOKEN=change-me-another-long-random-string
WA_WEBHOOK_URL=http://localhost/api/whatsapp/webhook

# Where the WhatsApp login session is stored. Keep it off the web root and back it up —
# deleting it forces a fresh QR scan.
# WA_AUTH_DIR=./auth

# silent | error | warn | info | debug — Baileys' own logging.
WA_LOG_LEVEL=silent

# Largest file the gateway will download from WhatsApp, in MB.
WA_MAX_MEDIA_MB=25

# Browser notifications: same public key as Laravel, private key only here.
WA_VAPID_SUBJECT=
WA_VAPID_PUBLIC_KEY=
WA_VAPID_PRIVATE_KEY=
