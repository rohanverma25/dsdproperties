{
  "name": "DSD Properties — Leads",
  "short_name": "DSD Leads",
  "description": "Follow-up tracker for DSD Properties buyer leads.",
  "start_url": "/admin/crm/leads",
  "scope": "/admin/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#0d6efd",
  "icons": [
    { "src": "/admin/icons/icon-192.png",     "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/admin/icons/icon-512.png",     "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/admin/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Today's follow-ups",
      "short_name": "Today",
      "url": "/admin/crm/leads",
      "icons": [{ "src": "/admin/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Add new lead",
      "short_name": "New Lead",
      "url": "/admin/crm/leads/create",
      "icons": [{ "src": "/admin/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
