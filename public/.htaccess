# ── Seller web app (PWA) ────────────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# The service worker must not be served from a stale cache, or sellers stay on an old
# version after a deploy. Its own scope is set at registration time.
<Files "sw-seller.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Service-Worker-Allowed "/seller/"
    </IfModule>
</Files>

<IfModule mod_rewrite.c>

    # Disable ModSecurity for blog editor AJAX save endpoints
    <IfModule mod_security2.c>
        SecRuleEngine Off
    </IfModule>
    <IfModule mod_security.c>
        SecFilterEngine Off
        SecFilterScanPOST Off
    </IfModule>

    # Increase request timeout (if server supports mod_reqtimeout)
    <IfModule mod_reqtimeout.c>
        RequestReadTimeout header=60-120,MinRate=500
        RequestReadTimeout body=60-120,MinRate=500
    </IfModule>

    # Prevent directory listing
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # One host only: www.dsdproperties.in -> https://dsdproperties.in (same path + query), so search engines
    # see one site instead of two copies. Other domains served by this app are not touched.
    RewriteCond %{HTTP_HOST} ^www\.dsdproperties\.in$ [NC]
    RewriteRule ^ https://dsdproperties.in%{REQUEST_URI} [L,R=301]

    # Map source PDFs are not offered for download (maps are shown only in the zoom viewers).
    # Since 18 Nov 2026 they 301 to the guide's map section instead of 410: varun-vihar-layout.pdf alone had 9,703
    # Google clicks in 3 months, and a redirect hands that ranking to the guide page. Still no download.
    # Documents that are not maps (circle-rate PDFs, UPSIDA gazette village list, sample report) stay open.
    RewriteRule ^images/maps/varun-vihar.*\.pdf$ https://dsdproperties.in/blog/varun-vihar-yojana-lucknow-lda-plots-guide-2026#vvmap-wrap [R=301,L,NC,NE]
    RewriteRule ^images/maps/wellness-city.*\.pdf$ https://dsdproperties.in/blog/wellness-city-lucknow-lda-plots-guide-2026#map-pdf [R=301,L,NC,NE]
    RewriteRule ^images/maps/it-city.*\.pdf$ https://dsdproperties.in/blog/it-city-lucknow-lda-plots-guide-2026#sector-map [R=301,L,NC,NE]
    RewriteRule ^images/maps/.+\.pdf$ https://dsdproperties.in/lda-schemes [R=301,L,NC]
    RewriteRule ^downloads/saumitra-vihar/ https://dsdproperties.in/blog/saumitra-vihar-yojana-lucknow-2026#layout-naksha [R=301,L,NC,NE]
    RewriteRule ^downloads/upsida/Ex-LIDA-Master-Plan-2041-UPSIDA\.pdf$ https://dsdproperties.in/blog/upsida-lucknow-ex-lida-master-plan-2041-village-list [R=301,L,NC]

    # Page URLs typed with /public/ (e.g. /public/blog/...) are duplicates of the clean URLs: 301 them.
    # Checked on the browser's original request line, so it only fires when /public/ was in the address.
    # Real files (images, PDFs, build assets) are left alone; only GET/HEAD, so form POSTs are never redirected.
    RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/public/?(\s|\?)
    RewriteRule ^$ https://%{HTTP_HOST}/ [L,R=301]
    RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)$ https://%{HTTP_HOST}/$1 [L,R=301]

    # Handle Authorization Header (for APIs, Sanctum, Passport, etc.)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller (index.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

</IfModule>

# PHP settings (works if PHP is loaded via mod_php)
<IfModule mod_php7.c>
    php_value max_execution_time 300
    php_value memory_limit 512M
    php_value post_max_size 64M
    php_value upload_max_filesize 64M
</IfModule>
